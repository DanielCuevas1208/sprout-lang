// fizzbuzz.spr - the classic interview game.
//
// Prints one line for each number from 1 to 15.
// Run: sprout run examples/fizzbuzz.spr

for i in range(1, 16) {
    let out = ""
    if i % 3 == 0 {
        out = out + "fizz"
    }
    if i % 5 == 0 {
        out = out + "buzz"
    }
    if out == "" {
        out = str(i)
    }
    print(out)
}
