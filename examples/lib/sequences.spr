// sequences.spr - number helpers shared by the examples.
//
// Run: none. Another program imports this module.
//
// Every top-level declaration becomes an export.

const golden_ratio = 1.618

fn sum_to(n) {
    let total = 0
    for i in range(1, n + 1) {
        total = total + i
    }
    return total
}

fn fibonacci(n) {
    if n < 2 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}
